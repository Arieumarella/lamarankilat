# ---- Identitas aplikasi ----
NODE_ENV=production
PORT=8092
HOST=0.0.0.0
BASE_URL=http://192.168.100.24:8092
APP_VERSION=0.1.0

# ---- Keamanan internal ----
# generate: openssl rand -hex 32
INTERNAL_TOKEN=
ADMIN_USER=admin
# password plain untuk seed pertama (di-hash saat boot, lalu boleh dikosongkan)
ADMIN_PASS=
SESSION_SECRET=

# ---- Database & penyimpanan ----
DB_PATH=/app/data/db/lamarankilat.db
ARTEFACT_DIR=/app/data/artefacts
MEDIA_DIR=/app/data/media
LOG_DIR=/app/data/logs
ARTEFACT_TTL_DAYS=30
DATA_RETENTION_DAYS=30

# ---- WhatsApp (Baileys) ----
WA_ENABLED=false
WA_SESSION_NAME=lamarankilat
WA_PHONE=
WA_DAILY_LIMIT=250
WA_QR_PHONE_HINT=

# ---- LLM (9Router, OpenAI-compatible) ----
ROUTER9_BASE_URL=https://9router.q-devstb.my.id/v1
ROUTER9_API_KEY=
ROUTER9_MODEL_PRIMARY=combo-coding-pertama-gan
ROUTER9_MODEL_FAST=combo-coding-pertama-gan
ROUTER9_TIMEOUT_MS=45000

# ---- Pembayaran ----
PAYMENT_MODE=transfer_manual
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=
QRIS_IMAGE_PATH=

# ---- Harga (rupiah) ----
PRICE_CV=15000
PRICE_BUNDLE=35000
PRICE_REVISION=10000

# ---- Alert ----
ALERT_TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=

TZ=Asia/Jakarta
